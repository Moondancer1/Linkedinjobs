# Это шаблон. Реальный .env создаётся при первом запуске (бот спросит токен) и в git не попадает.

# --- Telegram (обязательно) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Стартовые значения поиска ---
# Дальше всё меняется командами в Telegram (/keywords, /mode, /period, ...) и хранится в базе.
SEARCH_KEYWORDS=business administrator,media manager,marketing manager,administrative manager
REMOTE_ONLY=true
LOCATION=European Union
GEO_ID=91000002
TIME_RANGE_SECONDS=86400
MAX_PAGES=100

# --- Анти-бан ---
DELAY_MIN=2
DELAY_MAX=6
HEADLESS=true

# --- Режим работы ---
# 0 = один проход после /go; >0 = повторять каждые N минут, пока не /stop
INTERVAL_MINUTES=0
# Куда класть базу (по умолчанию рядом с main.py). Можно указать папку OneDrive/Dropbox,
# чтобы история просмотренных вакансий ездила с вами. Бот при этом должен работать только на одной машине.
# DB_PATH=

# --- Необязательно: ИИ для поиска контактов в тексте вакансии ---
# GEMINI_API_KEY ещё и включает запасной поиск кандидатов (/find), когда DuckDuckGo показал капчу или ничего не нашёл.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
